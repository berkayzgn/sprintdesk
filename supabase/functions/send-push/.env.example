# send-push Edge Function ortam değişkenleri (yalnızca adlar; gerçek değerler .env içinde, git'e girmez)
# Ayrıntı: taskmanager-mobile README → "Push bildirimleri"

# Trigger ile fonksiyonun paylaştığı gizli anahtar (private.settings / Vault'taki push_webhook_secret ile aynı)
PUSH_WEBHOOK_SECRET=

# APNs (.p8 anahtarı, Apple Developer → Keys)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
# .p8 dosyasının içeriği (BEGIN/END satırlarıyla; tek satırda \n ile de olur)
APNS_PRIVATE_KEY=

# FCM servis hesabı JSON'u (tek satır JSON ya da base64)
FCM_SERVICE_ACCOUNT=

# SUPABASE_URL ve SUPABASE_SERVICE_ROLE_KEY Edge Runtime tarafından otomatik verilir
